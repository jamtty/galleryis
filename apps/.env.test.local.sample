# 공지 E2E 점검용 관리자 계정 (apps/scripts/notice-e2e.mjs)
#
# 이 파일을 같은 폴더에 .env.test.local 이름으로 복사한 뒤 값을 채워 주세요.
# (.gitignore 의 *.local 규칙으로 커밋되지 않습니다)
NOTICE_TEST_ID=관리자_아이디_입력
NOTICE_TEST_PW=관리자_비밀번호_입력

# 서버 주소를 바꾸려면 아래 주석을 해제하세요 (기본값은 로컬 개발과 같은 서버)
# NOTICE_TEST_BASE=https://galleryiscom.mycafe24.com/backend
